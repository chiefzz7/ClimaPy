APP_NAME=ClimaPy
APP_ENV=development
APP_VERSION=0.2.0
APP_USER_AGENT=ClimaPy/0.2.0 (+https://climapy.local)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite+aiosqlite:///./climapy.db
WEATHER_CACHE_TTL_SECONDS=900
GEOCODING_CACHE_TTL_SECONDS=86400
HTTP_TIMEOUT_SECONDS=10.0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_GEOCODING=30/minute
RATE_LIMIT_REVERSE=15/minute
RATE_LIMIT_REMINDERS=10/minute
RATE_LIMIT_PUSH_TEST=5/minute
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=60

# Gerar localmente com:
# backend/.venv/bin/python backend/scripts/generate_keys.py --write
DATA_ENCRYPTION_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@climapy.local

# Opcionais futuros (mantenha vazio na v1)
WEATHERAPI_KEY=
AI_PROVIDER=none
